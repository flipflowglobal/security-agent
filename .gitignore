# Rust/Cargo build output
/target

# Packaged release archives produced by scripts/deploy.sh
/dist

# Cargo.lock is committed for binaries; exclude for libraries
# (this is a binary crate, so Cargo.lock is tracked)

# Environment and secrets — never commit
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets/
vault/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db

# Agent tooling scratch space (e.g. isolated subagent worktrees)
.claude/

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~
\#*\#
.#*

# Test and coverage artefacts
*.profraw
*.profdata
lcov.info
coverage/
tarpaulin-report.*

# Binary build outputs placed outside /target (e.g. manual ADB copies)
security-agent.bin

# Electron GUI
electron/node_modules/
electron/dist/
electron/out/

# Provisioned offline assets (downloaded/bundled locally, not source code):
#  - electron/tools/  bundled third-party tool binaries (~866 MB, copied into
#    the packaged app's resources/tools; installed by the packaging step)
#  - assets/model/    SmolLM2-360M weights + tokenizer (~691 MB; model.safetensors
#    exceeds GitHub's 100 MB per-file limit for regular git)
# Keep these local; a fresh clone rebuilds them via the packaging docs.
electron/tools/
assets/model/
# Preserved local checkpoints (redundant backups of bundled model weights)
assets/model-360m-backup/
assets/model-1.7b-unused/

# Electron CDP test log
electron/cdp.log
electron/cdp-run.log

# Log and report files generated by --run-tool
*.txt.tmp

# Python virtualenvs (sometimes created for tooling scripts)
venv/
.venv/
__pycache__/
*.pyc
node_modules/
opencode/

# User-generated engagement artifacts (safe to delete and regenerate)
# Findings / events / session / audit logs written by the CLI (see COMMAND.md).
*findings*.jsonl
*events*.jsonl
sessions*.jsonl
audit*.jsonl
# Embedded append-only stores (--findings-db, --audit-db, etc.)
*.sadb
# Real secrets copied from examples/secrets.example.env
# (the committed *.example.env templates stay tracked).
secrets.env
*.secrets.env

# Local OpenCode/agent configuration (personal, not for the repo)
dkconfig.json
dkconfig.jsonc
opencode.json
opencode.jsonc
Plan Security Agent OpenCode Config.txt
