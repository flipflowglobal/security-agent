# =============================================================================
# security-agent — secrets template (--secrets <file>)
# =============================================================================
# Copy this to engagements/secrets.env (gitignored — never commit real values)
# and reference secrets from tool/operator arguments as ${secret:NAME}:
#
#   --run-engagement <config> --secrets engagements/secrets.env \
#       -- --user ${secret:API_USER} --pass ${secret:API_TOKEN}
#
# Rules (see src/secrets.rs):
#   * one  name=value  per line;  # comments and blank lines are ignored
#   * a value may itself contain '='; later definitions override earlier ones
#   * environment variables SECAGENT_SECRET_* are merged in automatically
#     (SECAGENT_SECRET_API_TOKEN -> name "api_token")
#   * an unresolvable ${secret:NAME} FAILS CLOSED: the tool is never spawned
#   * resolved values are redacted from all recorded output
# -----------------------------------------------------------------------------

# API / web testing credentials (replace with real, short-lived test creds)
api_user=jane.testuser
api_token=replace-me-with-a-real-token

# Credential-testing inputs for hydra/ncrack-style runs (see
# internal-active-directory.conf); wordlists are referenced as file paths,
# which is why they live in the operator args, not here.
ssh_password=replace-me
smb_password=replace-me

# Example of a secret that legitimately contains '=' characters
basic_auth_header=Authorization: Bearer replace-me
