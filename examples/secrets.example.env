# =============================================================================
# security-agent — example secrets file  (for --run-engagement --secrets)
# =============================================================================
# Put sensitive values here instead of in the command line or the config.
# In tool arguments (e.g. operator args after `--`), reference a secret as
# ${secret:NAME}; the engine resolves it just before spawning the tool and
# redacts the value from all recorded output.
#
# Format:
#   * one  NAME=value  per line
#   * lines starting with #  and blank lines are ignored
#   * the value is everything after the first '=' (it may contain '=' itself)
#
# The engine also reads secrets from the environment, so you can keep the
# most sensitive ones out of any file entirely.
#
# SECURITY: never commit a real secrets file. Copy this to secrets.env, fill it
# in, and keep it out of version control (add it to .gitignore).
# -----------------------------------------------------------------------------

# Example: an API token a tool needs, referenced as ${secret:API_TOKEN}
API_TOKEN=replace-me

# Example: HTTP basic-auth password, referenced as ${secret:BASIC_AUTH_PW}
BASIC_AUTH_PW=replace-me

# Usage example (the tool never sees the literal, and output is redacted):
#   security-agent --run-engagement my-engagement.conf \
#     --allow-network --secrets secrets.env \
#     -- --header "Authorization: Bearer ${secret:API_TOKEN}"
